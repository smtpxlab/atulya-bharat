# ---- Runtime ----
NODE_ENV=development
PORT=8000
APP_NAME=atulya-bharat-run-api
API_VERSION=v1
LOG_LEVEL=info

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- PostgreSQL (Railway Postgres) ----
DATABASE_URL=postgres://user:pass@host:5432/atulya_bharat_run
DATABASE_SSL=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ---- Redis (Railway Redis) ----
REDIS_URL=redis://default:pass@host:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
COOKIE_SECRET=change-me-cookie

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=atulya-bharat-run
R2_PUBLIC_BASE_URL=

# ---- SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Atulya Bharat Run <no-reply@atulyabharatrun.com>"

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Strava ----
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
STRAVA_REDIRECT_URI=

# ---- Frontend origins (redirects, links in emails) ----
PUBLIC_APP_URL=https://atulyabharatrun.com
